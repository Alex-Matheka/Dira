<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:text="Register Candidate"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:text="Candidate ID / Reg No:"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCandidateId"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#EBEBEB"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:hint="e.g. CAND-101"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/black"
        android:textColorHint="#757575"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:text="Candidate Full Name:"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCandidateName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#EBEBEB"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:hint="Enter Full Name"
        android:inputType="textPersonName"
        android:paddingHorizontal="12dp"
        android:textColor="@color/black"
        android:textColorHint="#757575"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:text="Position :"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCandidatePosition"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#EBEBEB"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:hint="e.g. President / Vice President"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/black"
        android:textColorHint="#757575"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:text="Party "
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCandidateParty"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#EBEBEB"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:hint="e.g. Independent / Reform Party"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/black"
        android:textColorHint="#757575"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:text="Cancel"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/gold"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:text="Register"
            android:textColor="@color/white" />

    </LinearLayout>

</LinearLayout>
